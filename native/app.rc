#include <winver.h>

101 ICON "winputtier.ico"

1 VERSIONINFO
 FILEVERSION 0,5,0,0
 PRODUCTVERSION 0,5,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "WinPuttier Contributors\0"
            VALUE "FileDescription", "WinPuttier - PuTTY Theme Manager\0"
            VALUE "FileVersion", "0.5.0\0"
            VALUE "InternalName", "WinPuttier\0"
            VALUE "OriginalFilename", "WinPuttier.exe\0"
            VALUE "ProductName", "WinPuttier\0"
            VALUE "ProductVersion", "0.5.0\0"
            VALUE "LegalCopyright", "WinPuttier contributors; original Puttier CC0-1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
