#include <winver.h>
#include "winputtier_version.h"

101 ICON "winputtier.ico"

1 VERSIONINFO
 FILEVERSION WINPUTTIER_VERSION_RESOURCE
 PRODUCTVERSION WINPUTTIER_VERSION_RESOURCE
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "WinPuttier Contributors\0"
            VALUE "FileDescription", "WinPuttier - PuTTY Theme Manager\0"
            VALUE "FileVersion", WINPUTTIER_VERSION_TEXT
            VALUE "InternalName", "WinPuttier\0"
            VALUE "OriginalFilename", "WinPuttier.exe\0"
            VALUE "ProductName", "WinPuttier\0"
            VALUE "ProductVersion", WINPUTTIER_VERSION_TEXT
            VALUE "LegalCopyright", "WinPuttier contributors; original Puttier CC0-1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
